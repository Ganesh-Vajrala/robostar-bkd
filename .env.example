# ---- Server ----
PORT=3000
# A secret each ESP32 box uses in the X-Machine-Key header to talk to the backend.
# Generate one per machine later; one shared value is fine for Phase 0 testing.
MACHINE_API_KEY=change_me_to_a_long_random_string

# ---- Database (PostgreSQL) ----
# Local:  postgres://user:pass@localhost:5432/massagebox
# Railway/Render will give you this as a single connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/massagebox
# Set to "true" when your host requires SSL (Railway/Render/Neon usually do).
DATABASE_SSL=false

# ---- Razorpay ----
# From Dashboard -> Settings -> API Keys (use TEST keys first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# From Dashboard -> Settings -> Webhooks (a value YOU choose when creating the webhook)
RAZORPAY_WEBHOOK_SECRET=choose_a_separate_webhook_secret
