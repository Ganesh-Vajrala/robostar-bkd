# ---- Server ----
PORT=3000
MACHINE_API_KEY=change_me_to_a_long_random_string

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/massagebox
DATABASE_SSL=false

# ---- Razorpay (UPI path) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose_a_separate_webhook_secret

# ---- RFID demo (for seed-wallet) ----
# Set this to the UID your RC522 prints when you tap your test card.
DEMO_CARD_UID=A1B2C3D4
